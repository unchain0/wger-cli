# Copy to .env and fill in values, or export in your shell.
# The CLI reads these from the process environment (no dotenv loader).

# Required for writes and private user data (routine, logs, sessions).
# Create at: wger account → API key. Public catalog reads work without it.
WGER_API_TOKEN=

# Optional. Defaults to https://wger.de
# WGER_BASE_URL=https://wger.de
